@model IEnumerable<CV_AI.Models.Application>

@{
    ViewData["Title"] = "Quản lý Đơn ứng tuyển";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-table">
    <div class="table-header d-flex justify-content-between align-items-center">
        <h5 class="table-title mb-0">
            <i class="fas fa-file-alt"></i>
            Danh sách Đơn ứng tuyển (@Model.Count())
        </h5>
        <div class="d-flex gap-2">
            <form method="get" class="d-flex gap-2">
                <select name="status" class="form-select" style="min-width: 180px;" onchange="this.form.submit()">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Pending" selected="@(ViewBag.Status == "Pending")">
                        Chờ xử lý
                    </option>
                    <option value="Accepted" selected="@(ViewBag.Status == "Accepted")">
                        Đã chấp nhận
                    </option>
                    <option value="Rejected" selected="@(ViewBag.Status == "Rejected")">
                        Đã từ chối
                    </option>
                </select>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Ứng viên</th>
                    <th>Vị trí ứng tuyển</th>
                    <th>Công ty</th>
                    <th>Ngày nộp</th>
                    <th colspan="2">Thông tin</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Model)
                {
                    <tr>
                        <td><strong>#@app.ID_Application</strong></td>
                        <td>
                            @if (app.Candidate?.User != null)
                            {
                                <div class="d-flex align-items-center">
                                    <div class="user-avatar" style="width:30px;height:30px;font-size:0.8rem;margin-right:0.5rem;">
                                        @app.Candidate.User.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <strong>@app.Candidate.User.FullName</strong>
                                        <br>
                                        <small class="text-muted">@app.Candidate.User.Email</small>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>
                        <td>
                            @if (app.JobPost != null)
                            {
                                <div>
                                    <strong>@app.JobPost.Title</strong>
                                    <br>
                                    <small class="text-muted">
                                        <i class="fas fa-map-marker-alt"></i> @app.JobPost.Location
                                    </small>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>
                        <td>
                            @if (app.JobPost?.Employer != null)
                            {
                                <small>
                                    <i class="fas fa-building text-muted"></i>
                                    @app.JobPost.Employer.CompanyName
                                </small>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>
                        <td>
                            <small>@app.AppliedDate.ToString("dd/MM/yyyy HH:mm")</small>
                        </td>
                        <td colspan="2">
                            <small class="text-muted">
                                <i class="fas fa-info-circle"></i> 
                                Ứng tuyển qua hệ thống
                            </small>
                        </td>
                        <td>
                            @if (app.Status == "Pending")
                            {
                                <span class="badge bg-warning">
                                    <i class="fas fa-clock"></i> Chờ xử lý
                                </span>
                            }
                            else if (app.Status == "Accepted")
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle"></i> Đã chấp nhận
                                </span>
                            }
                            else if (app.Status == "Rejected")
                            {
                                <span class="badge bg-danger">
                                    <i class="fas fa-times-circle"></i> Đã từ chối
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@app.Status</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
            <p class="text-muted">Không tìm thấy đơn ứng tuyển nào</p>
        </div>
    }
</div>

<!-- Statistics Cards -->
<div class="row g-4 mt-4">
    <div class="col-md-4">
        <div class="stats-card warning">
            <div class="text-center">
                <div class="stats-icon warning mx-auto mb-3">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="stats-title">Chờ xử lý</div>
                <div class="stats-value">@Model.Count(a => a.Status == "Pending")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stats-card success">
            <div class="text-center">
                <div class="stats-icon success mx-auto mb-3">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stats-title">Đã chấp nhận</div>
                <div class="stats-value">@Model.Count(a => a.Status == "Accepted")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stats-card danger">
            <div class="text-center">
                <div class="stats-icon danger mx-auto mb-3">
                    <i class="fas fa-times-circle"></i>
                </div>
                <div class="stats-title">Đã từ chối</div>
                <div class="stats-value">@Model.Count(a => a.Status == "Rejected")</div>
            </div>
        </div>
    </div>
</div>

