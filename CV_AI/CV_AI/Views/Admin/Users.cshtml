@model IEnumerable<CV_AI.Models.User>

@{
    ViewData["Title"] = "Quản lý Người dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-table">
    <div class="table-header d-flex justify-content-between align-items-center">
        <h5 class="table-title mb-0">
            <i class="fas fa-users"></i>
            Danh sách Người dùng (@Model.Count())
        </h5>
        <div class="d-flex gap-2">
            <form method="get" class="d-flex gap-2">
                <input type="text" name="searchTerm" class="form-control" placeholder="Tìm kiếm..." 
                       value="@ViewBag.SearchTerm" style="min-width: 250px;">
                <select name="roleFilter" class="form-select" style="min-width: 150px;">
                    <option value="">Tất cả</option>
                    <option value="Candidate" selected="@(ViewBag.RoleFilter == "Candidate")">Ứng viên</option>
                    <option value="Employer" selected="@(ViewBag.RoleFilter == "Employer")">Nhà tuyển dụng</option>
                    <option value="Admin" selected="@(ViewBag.RoleFilter == "Admin")">Admin</option>
                </select>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> Tìm
                </button>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Thông tin thêm</th>
                    <th>Ngày tạo</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="user-avatar" style="width:35px;height:35px;font-size:0.9rem;margin-right:0.75rem;">
                                    @user.FullName.Substring(0, 1).ToUpper()
                                </div>
                                <strong>@user.FullName</strong>
                            </div>
                        </td>
                        <td>@user.Email</td>
                        <td>
                            @if (user.Role == "Candidate")
                            {
                                <span class="badge bg-info">
                                    <i class="fas fa-user-graduate"></i> Ứng viên
                                </span>
                            }
                            else if (user.Role == "Employer")
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-building"></i> Nhà tuyển dụng
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    <i class="fas fa-user-shield"></i> Admin
                                </span>
                            }
                        </td>
                        <td>
                            @if (user.Role == "Candidate" && user.Candidate != null)
                            {
                                <small class="text-muted">
                                    <i class="fas fa-phone"></i> @(user.Candidate.Phone ?? "Chưa cập nhật")
                                </small>
                            }
                            else if (user.Role == "Employer" && user.Employer != null)
                            {
                                <small class="text-muted">
                                    <i class="fas fa-building"></i> @user.Employer.CompanyName
                                </small>
                            }
                            else
                            {
                                <small class="text-muted">-</small>
                            }
                        </td>
                        <td>
                            <small>@user.CreatedAt.ToString("dd/MM/yyyy")</small>
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle"></i> Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="fas fa-ban"></i> Đã khóa
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            @if (user.Role != "Admin")
                            {
                                <button class="btn btn-sm btn-warning btn-action" onclick="toggleUserStatus('@user.Id')">
                                    <i class="fas fa-@(user.IsActive ? "lock" : "unlock")"></i>
                                    @(user.IsActive ? "Khóa" : "Mở khóa")
                                </button>
                                <button class="btn btn-sm btn-danger btn-action" onclick="deleteUser('@user.Id', '@user.FullName')">
                                    <i class="fas fa-trash"></i> Xóa
                                </button>
                            }
                            else
                            {
                                <span class="text-muted"><i class="fas fa-shield-alt"></i> Bảo vệ</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function toggleUserStatus(userId) {
            if (confirm('Bạn có chắc muốn thay đổi trạng thái người dùng này?')) {
                $.post('/Admin/ToggleUserStatus', { userId: userId }, function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message || 'Có lỗi xảy ra!');
                    }
                });
            }
        }

        function deleteUser(userId, userName) {
            if (confirm(`Bạn có chắc muốn XÓA người dùng "${userName}"?\n\nHành động này KHÔNG THỂ HOÀN TÁC!`)) {
                $.post('/Admin/DeleteUser', { userId: userId }, function(response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert(response.message || 'Có lỗi xảy ra!');
                    }
                });
            }
        }
    </script>
}

