@model CV_AI.Models.Feedback
@{
    ViewData["Title"] = "Chi tiết góp ý";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    
    string statusClass = Model.Status switch
    {
        "Pending" => "bg-warning text-dark",
        "In Progress" => "bg-info text-white",
        "Resolved" => "bg-success text-white",
        "Closed" => "bg-secondary text-white",
        _ => ""
    };
    
    string priorityClass = Model.Priority switch
    {
        "Low" => "bg-success text-white",
        "Medium" => "bg-info text-white",
        "High" => "bg-warning text-dark",
        "Urgent" => "bg-danger text-white",
        _ => ""
    };
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Chi tiết góp ý</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/Admin/Dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="/Admin/AdminFeedback">Quản lý góp ý</a></li>
        <li class="breadcrumb-item active">Chi tiết góp ý #@Model.Id</li>
    </ol>
    
    <div class="card mb-4">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-comment-alt me-1"></i>
                    Thông tin góp ý #@Model.Id
                </div>
                <div>
                    <a href="/Admin/AdminFeedback" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="mb-3">
                        <h5 class="text-muted">Thông tin người gửi</h5>
                        <div class="mb-2">
                            <strong>Họ tên:</strong> @Model.UserName
                        </div>
                        <div class="mb-2">
                            <strong>Email:</strong> @Model.UserEmail
                        </div>
                        <div class="mb-2">
                            <strong>User ID:</strong> @Model.UserId
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <h5 class="text-muted">Thông tin góp ý</h5>
                        <div class="mb-2">
                            <strong>Loại góp ý:</strong>
                            @switch (Model.Category)
                            {
                                case "Bug Report":
                                    <span class="badge bg-danger">Báo lỗi</span>
                                    break;
                                case "Feature Request":
                                    <span class="badge bg-primary">Đề xuất tính năng</span>
                                    break;
                                case "General Feedback":
                                    <span class="badge bg-info">Góp ý chung</span>
                                    break;
                                case "Complaint":
                                    <span class="badge bg-warning text-dark">Khiếu nại</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@Model.Category</span>
                                    break;
                            }
                        </div>
                        <div class="mb-2">
                            <strong>Trạng thái:</strong>
                            <span class="badge @statusClass">@Model.Status</span>
                        </div>
                        <div class="mb-2">
                            <strong>Mức độ ưu tiên:</strong>
                            <span class="badge @priorityClass">@Model.Priority</span>
                        </div>
                        <div class="mb-2">
                            <strong>Ngày tạo:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </div>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <div class="mb-2">
                                <strong>Cập nhật lần cuối:</strong> @Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        }
                        @if (Model.ResolvedAt.HasValue)
                        {
                            <div class="mb-2">
                                <strong>Ngày giải quyết:</strong> @Model.ResolvedAt.Value.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            <div class="mb-4">
                <h5>@Model.Subject</h5>
                <div class="card bg-light">
                    <div class="card-body">
                        @Html.Raw(Model.Content.Replace("\n", "<br>"))
                    </div>
                </div>
            </div>
            
            @if (!string.IsNullOrEmpty(Model.AdminResponse))
            {
                <div class="mb-4">
                    <h5>Phản hồi của Admin</h5>
                    <div class="card bg-light">
                        <div class="card-body">
                            @Html.Raw(Model.AdminResponse.Replace("\n", "<br>"))
                        </div>
                    </div>
                </div>
            }
            
            <hr />
            
            <form id="updateForm" method="post" action="/Admin/AdminFeedback/UpdateStatus">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="status" class="form-label">Cập nhật trạng thái</label>
                            <select class="form-select" id="status" name="status">
                                @{
                                bool isPending = Model.Status == "Pending";
                                bool isInProgress = Model.Status == "In Progress";
                                bool isResolved = Model.Status == "Resolved";
                                bool isClosed = Model.Status == "Closed";
                            }
                            <option value="Pending" selected="@isPending">Đang chờ</option>
                            <option value="In Progress" selected="@isInProgress">Đang xử lý</option>
                            <option value="Resolved" selected="@isResolved">Đã giải quyết</option>
                            <option value="Closed" selected="@isClosed">Đã đóng</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="priority" class="form-label">Mức độ ưu tiên</label>
                            <select class="form-select" id="priority" name="priority">
                                @{
                                bool isLow = Model.Priority == "Low";
                                bool isMedium = Model.Priority == "Medium";
                                bool isHigh = Model.Priority == "High";
                                bool isUrgent = Model.Priority == "Urgent";
                            }
                            <option value="Low" selected="@isLow">Thấp</option>
                            <option value="Medium" selected="@isMedium">Trung bình</option>
                            <option value="High" selected="@isHigh">Cao</option>
                            <option value="Urgent" selected="@isUrgent">Khẩn cấp</option>
                            </select>
                        </div>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label for="adminResponse" class="form-label">Phản hồi</label>
                    <textarea class="form-control" id="adminResponse" name="adminResponse" rows="5">@Model.AdminResponse</textarea>
                </div>
                
                <div class="d-flex justify-content-between">
                    <div>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Cập nhật
                        </button>
                        <a href="/Admin/AdminFeedback" class="btn btn-outline-secondary">
                            <i class="fas fa-times"></i> Hủy
                        </a>
                    </div>
                    <div>
                        <button type="button" class="btn btn-danger" id="deleteBtn">
                            <i class="fas fa-trash"></i> Xóa
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Xác nhận xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn xóa góp ý này không?</p>
                <p class="text-danger">Hành động này không thể hoàn tác!</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <form id="deleteForm" method="post" action="/Admin/AdminFeedback/Delete/@Model.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Xóa</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Toastr for notifications -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // Xử lý form cập nhật
            $('#updateForm').submit(function(e) {
                e.preventDefault();
                
                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function(response) {
                        if (response.success) {
                            toastr.success(response.message);
                            setTimeout(function() {
                                location.reload();
                            }, 1000);
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function() {
                        toastr.error('Đã xảy ra lỗi khi cập nhật');
                    }
                });
            });
            
            // Xử lý nút xóa
            $('#deleteBtn').click(function() {
                $('#deleteModal').modal('show');
            });
            
            // Xử lý form xóa
            $('#deleteForm').submit(function(e) {
                e.preventDefault();
                
                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function(response) {
                        if (response.success) {
                            toastr.success(response.message);
                            setTimeout(function() {
                                window.location.href = '/Admin/AdminFeedback';
                            }, 1000);
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function() {
                        toastr.error('Đã xảy ra lỗi khi xóa');
                    }
                });
            });
        });
    </script>
}

